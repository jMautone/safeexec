# SafeExec configuration — copy to .env and adjust. Never commit real secrets.
SAFEEXEC_LOG_LEVEL=INFO
SAFEEXEC_DATABASE_URL=postgresql+asyncpg://safeexec:safeexec@localhost:5432/safeexec

# Sandbox backend (Docker)
SAFEEXEC_PYTHON_IMAGE=python:3.13-slim
SAFEEXEC_NODE_IMAGE=node:22-slim
# Optional hardened runtime, e.g. runsc (gVisor). Empty = default runc.
#SAFEEXEC_SANDBOX_RUNTIME=runsc
SAFEEXEC_SANDBOX_USER=65534:65534
# Base dir for per-execution workdirs. Must be visible to the Docker daemon
# under the same path (bind-mounted when the API itself runs in a container).
#SAFEEXEC_SANDBOX_WORKDIR_BASE=/var/tmp/safeexec
SAFEEXEC_DOCKER_TIMEOUT_SECONDS=10

# Resource limit policy (defaults and hard maximums)
SAFEEXEC_DEFAULT_TIMEOUT_MS=5000
SAFEEXEC_MAX_TIMEOUT_MS=30000
SAFEEXEC_DEFAULT_MEMORY_MB=128
SAFEEXEC_MAX_MEMORY_MB=512
SAFEEXEC_DEFAULT_CPUS=0.5
SAFEEXEC_MAX_CPUS=2.0
SAFEEXEC_DEFAULT_MAX_OUTPUT_BYTES=65536
SAFEEXEC_MAX_MAX_OUTPUT_BYTES=1048576

# Capacity
SAFEEXEC_MAX_CONCURRENT_EXECUTIONS=4
